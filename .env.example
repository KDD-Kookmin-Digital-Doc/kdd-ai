# AWS Bedrock 설정
BEDROCK_ANSWER_MODEL_ID=apac.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=global.cohere.embed-v4:0
BEDROCK_LIGHT_MODEL_ID=apac.anthropic.claude-3-haiku-20240307-v1:0
# 경고: 실제 키를 커밋하지 마세요. Lightsail은 IAM Role 미지원이라 환경변수 방식을 사용하며,
# 운영 환경에서는 배포 파이프라인의 시크릿 저장소를 통해 주입합니다.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_REGION=ap-northeast-2
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# 임베딩 및 LLM 설정
EMBEDDING_DIMENSION=1024
# 문서 적재 시 한 번의 Bedrock embed 호출에 묶을 청크 수 (기본 48).
# Cohere v4 read_timeout 초과 회피와 Throttling 사이의 균형값. 큰 문서일수록 낮게.
EMBED_BATCH_SIZE=48
LLM_CONTEXT_WINDOW=200000
LLM_MAX_TOKENS=1024

# PostgreSQL (RDS) 설정 — D3 마이그레이션 (Supabase → RDS asyncpg, 2026-05-13)
# SSL 모드 가이드:
# - sslmode=require: SSL 강제하되 CA 인증서 검증 없음 (MitM 표면 존재).
#   Lightsail-RDS 가 같은 region 이지만 다른 VPC 라 public 경로 사용 →
#   SG 인바운드 단일 IP (Lightsail public IP) 가드로 표면 매우 낮음.
#   알파/베타 baseline 충분.
# - sslmode=verify-full + sslrootcert=...: MitM 차단 강화.
#   CA bundle 다운로드: https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
#   예: ?sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-global-bundle.pem
DATABASE_URL=postgresql://master_user:password@alpha-ai-rds.xxx.ap-northeast-2.rds.amazonaws.com:5432/alpha_ai?sslmode=require
# asyncpg connection pool 크기 (min ≤ max). 베타 트래픽 기준 기본값 충분.
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10

# 유사도 임계값
SIMILARITY_THRESHOLD=0.75
CACHE_SIMILARITY_THRESHOLD=0.95
# 벡터 검색 폴백(answer_cache 유사 질문 추출) floor 임계값. 너무 낮으면
# 무관한 질문이 fallback 으로 노출됨 (이슈 #46).
FALLBACK_SIMILARITY_THRESHOLD=0.5

# 검색/LLM 매직넘버 (PR-R5). 운영 튜닝 시 조정.
VECTOR_SEARCH_TOP_K=5
FALLBACK_SUGGESTED_COUNT=3
REWRITE_MAX_TOKENS=512
INTENT_MAX_TOKENS=16
CHITCHAT_MAX_TOKENS=256
FAQ_LLM_MAX_TOKENS=512
BEDROCK_MAX_RETRIES=2
# FAQ 답변 초안 생성 시 동시 Bedrock LLM 호출 수 (PR #61, R8 병렬화).
# 너무 높으면 Bedrock throttling, 너무 낮으면 5개 클러스터 직렬화로 응답 지연.
FAQ_CONCURRENCY=5

# confidence 임계값
CONFIDENCE_HIGH_THRESHOLD=0.9
CONFIDENCE_MEDIUM_THRESHOLD=0.8

# Rerank (D1, Task 13) — Cohere Rerank 3.5 (Single-region, 도쿄)
# False 시 단일 단계 (VECTOR_SEARCH_TOP_K) 검색으로 회귀.
RERANK_ENABLED=True
RERANK_REGION=ap-northeast-1
RERANK_MODEL_ID=cohere.rerank-v3-5:0
# Stage 1 (임베딩) 후보 수. RERANK_ENABLED=True 일 때만 사용.
RETRIEVE_TOP_K_RERANK=30
# Stage 2 (리랭크) 최종 컨텍스트 개수. RETRIEVE_TOP_K_RERANK 이하여야 함.
RERANK_TOP_N=5
# Rerank API timeout (도쿄 RTT + 모델 처리 여유, 기본 15초).
BEDROCK_RERANK_TIMEOUT=15

# 캐시 만료 정책
CACHE_TTL_DAYS=90

# 의도 분류 보조 컨텍스트
# BE가 history 최대 10턴까지 던지는 만큼 분류용으로도 넉넉히 (기본 6턴 ≈ 3 QA 쌍).
# 너무 적으면 멀티턴 학사 후속 질문이 chitchat으로 빠질 수 있고, 너무 많으면 입력 토큰이 커진다.
INTENT_HISTORY_TURNS=6
# 분류 입력에 첨부할 history 메시지 1개당 최대 글자 수 (기본 200).
INTENT_HISTORY_CHARS_PER_TURN=200

# 타임아웃 (초)
# 임베딩 connect 타임아웃 (기본 10). connect 실패는 빠르게 감지.
BEDROCK_EMBEDDING_CONNECT_TIMEOUT=10
# 임베딩 read 타임아웃 (기본 30). EMBED_BATCH_SIZE와 함께 조정.
BEDROCK_EMBEDDING_TIMEOUT=30
BEDROCK_LLM_TIMEOUT=30
POSTGRES_TIMEOUT=10

# asyncio 기본 ThreadPoolExecutor 크기. invoke_llm_stream / embed_texts /
# rerank 가 잠시 점유하는 I/O 스레드 풀. Python 기본(min(32, cpu+4))은 2 vCPU
# Lightsail 에서 6 → 7번째 동시 LLM 스트림부터 큐잉되므로 명시 확장.
# 2GB 박스 베이스라인엔 32 권장 (Python 자체 상한과 동일, 스택 ~256MB 안전).
THREAD_POOL_MAX_WORKERS=32

# CORS (미설정 시 비활성, 서버 간 통신이라 기본적으로 불필요)
# CORS_ORIGINS=["http://localhost:3000"]

# 로깅 레벨 (DEBUG/INFO/WARNING/ERROR/CRITICAL, 기본 INFO).
# 알파테스트 동안 임베딩 재사용 등 최적화 동작 검증이 필요하면 DEBUG 권장:
#   docker logs alpha-ai-server | grep "임베딩 재사용"
# 운영 안정화 후 INFO 또는 미지정으로 복귀해 노이즈 정리.
LOG_LEVEL=INFO

# AWS Bedrock 설정
BEDROCK_ANSWER_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=cohere.embed-multilingual-v3
BEDROCK_LIGHT_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AWS_REGION=us-east-1

# 임베딩 및 LLM 설정
EMBEDDING_DIMENSION=1024
LLM_CONTEXT_WINDOW=200000
LLM_MAX_TOKENS=1024

# Supabase 설정
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# 유사도 임계값
SIMILARITY_THRESHOLD=0.75
CACHE_SIMILARITY_THRESHOLD=0.95

# 캐시 만료 정책
CACHE_TTL_DAYS=90

# 타임아웃 (초)
BEDROCK_LLM_TIMEOUT=30
BEDROCK_EMBEDDING_TIMEOUT=15
SUPABASE_TIMEOUT=10
